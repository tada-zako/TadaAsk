# API Key 加密配置
PROVIDER_API_KEY_ENCRYPTION_KEY="Fernet.generate_key() 输出的值"
PROVIDER_API_KEY_PREVIOUS_ENCRYPTION_KEYS="旧密钥1,旧密钥2"  # 逗号分隔的旧密钥列表；用于解密之前加密的 API Key

# LLM 请求默认参数
LLM_DEFAULT_CONTEXT_WINDOW_TOKENS=32768
LLM_DEFAULT_MAX_OUTPUT_TOKENS=4096
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_TOP_P=0.95
LLM_DEFAULT_TIMEOUT=60.0
LLM_DEFAULT_THINKING="medium"

# 文件存储配置
FILE_STORAGE_BACKEND="local"  # 文件存储后端，默认为 "local"
MAX_FILE_SIZE=5242880   # 最大文件上传大小，单位为字节（这里设置为 5MB）
MAX_FILE_COUNT=8  # 最大文件上传数量
UPLOAD_FOLDER_PATH="./storages/uploads"  # 文件上传存储路径

# 向量库偏好设置
VECTOR_STORE_PERF="chromadb"

# RAG 相关配置
EMBEDDING_BACKEND="fastembed"  # 文本嵌入后端，默认为 "fastembed"
RERANK_BACKEND="fastembed"  # Rerank 后端，默认为 "fastembed"
HYDE_ENABLED=false  # 是否启用 HyDE 生成虚拟文档增强检索，默认为 false

EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"  # 文本嵌入模型名称
RERANK_MODEL_NAME="Xenova/ms-marco-MiniLM-L-6-v2"  # Rerank 模型名称，默认使用较小模型以降低首次启动下载成本


# 模型路径
FASTEMBED_MODEL_PATH=""  # FastEmbed 模型路径，默认由 fastembed 内部处理
LLAMACPP_MODEL_PATH=""  # LLaMA.cpp 模型路径，默认由
# ChromaDB 存储路径
CHROMADB_PATH=./storages/chromadb
# SQLite 数据库路径
SQLITE_PATH=./storages/sqlite.db

# visitor 侧请求限制
VISITOR_RATE_LIMIT_ENABLED=true  # 是否启用 visitor 请求限制
VISITOR_RATE_LIMIT_IP_PROJECT_PER_MINUTE=6  # 每 IP + project：6 次 / 分钟
VISITOR_RATE_LIMIT_IP_PROJECT_PER_HOUR=60  # 每 IP + project：60 次 / 小时
VISITOR_RATE_LIMIT_IP_PER_MINUTE=20  # 每 IP 全局：20 次 / 分钟
VISITOR_RATE_LIMIT_PROJECT_PER_MINUTE=120  # 每 project 全局：120 次 / 分钟
VISITOR_STREAM_CONCURRENCY_PER_IP=2  # 每 IP 同时 stream：2
VISITOR_STREAM_CONCURRENCY_PER_PROJECT=20  # 每 project 同时 stream：20
VISITOR_MESSAGE_MAX_CHARS=4000  # visitor 侧单条消息最大字符数

# 是否信任代理头部信息（X-Forwarded-For）；
# 如果信任，首先会解析 X-Forwarded-For 头部获取真实客户端 IP；
# 若部署在可信代理后面（如 Nginx、Traefik 等），
# 请通过运行 fastapi run main.py --forwarded-allow-ips="*" 设置可信代理 IP，
# 依旧推荐设置 VISITOR_TRUST_PROXY_HEADERS=false;
VISITOR_TRUST_PROXY_HEADERS=false  

# JWT 配置
JWT_SECRET_KEY="openssl rand -hex 32 输出的值"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理员账号配置
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here
