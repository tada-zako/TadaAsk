# LLM 提供商偏好设置
LLM_PROVIDER_PERF="google"

# Gemini 模型配置
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PERF="gemini-2.5-flash"

# 向量库偏好设置
VECTOR_STORE_PERF="chromadb"

# ChromaDB 存储路径
CHROMADB_PATH=./storage/chromadb
# SQLite 数据库路径
SQLITE_PATH=./storage/sqlite.db

# JWT 配置
JWT_SECRET_KEY=change_this_to_a_secure_random_string
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理员账号配置
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here