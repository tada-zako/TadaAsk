# LLM 提供商偏好设置
LLM_PROVIDER_ADMIN="google"
LLM_PROVIDER_VISITOR="deepseek"

# Gemini 模型配置
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PERF="gemini-2.5-flash"
# DeepSeek 模型配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL_PERF="DeepSeek-V4-Flash"

# LLM 请求默认参数
LLM_DEFAULT_CONTEXT_WINDOW_TOKENS=32768
LLM_DEFAULT_MAX_OUTPUT_TOKENS=4096
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_TOP_P=0.95
LLM_DEFAULT_TIMEOUT=60.0
LLM_DEFAULT_THINKING="medium"

FILE_STORAGE_BACKEND="local"  # 文件存储后端，默认为 "local"
MAX_FILE_SIZE=5242880   # 最大文件上传大小，单位为字节（这里设置为 5MB）
MAX_FILE_COUNT=8  # 最大文件上传数量
UPLOAD_FOLDER_PATH="./storages/uploads"  # 文件上传存储路径

# 向量库偏好设置
VECTOR_STORE_PERF="chromadb"

# RAG 相关配置
EMBEDDING_BACKEND="fastembed"  # 文本嵌入后端，默认为 "fastembed"
RERANK_BACKEND="fastembed"  # Rerank 后端，默认为 "fastembed"
HYDE_ENABLED=false  # 是否启用 HyDE 生成虚拟文档增强检索，默认为 false

EMBEDDING_MODEL_NAME=""  # 文本嵌入模型名称，默认由具体嵌入实现内部处理
RERANK_MODEL_NAME=""  # Rerank 模型名称，默认由具体实现内部处理


# 模型路径
FASTEMBED_MODEL_PATH=""  # FastEmbed 模型路径，默认由 fastembed 内部处理
LLAMACPP_MODEL_PATH=""  # LLaMA.cpp 模型路径，默认由
# ChromaDB 存储路径
CHROMADB_PATH=./storages/chromadb
# SQLite 数据库路径
SQLITE_PATH=./storages/sqlite.db

# JWT 配置
JWT_SECRET_KEY=change_this_to_a_secure_random_string
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理员账号配置
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here
