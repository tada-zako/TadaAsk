{
  "name": "tadaask-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "TadaAsk admin console and visitor widget",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11.13.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "dev:widget": "vite --open /widget/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b",
    "build:console": "vite build",
    "build:widget": "vite build --config vite.widget.config.ts",
    "build": "pnpm run typecheck && pnpm run build:console && pnpm run build:widget",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "update-api": "openapi-typescript http://localhost:8000/openapi.json -o src/shared/api/generated/schema.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@mdit/plugin-katex": "^1.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
