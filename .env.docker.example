# Docker 对外提供 Console、Widget 与 API 的端口
TADAASK_PORT=8080

# 默认仅监听宿主机 loopback，由服务器外层 TLS Nginx/Caddy 反代
TADAASK_BIND_ADDRESS=127.0.0.1

# NOTE: 无结尾斜杠；该地址会在构建前端镜像时写入 Widget 部署代码
TADAASK_PUBLIC_URL=http://localhost:8080

# Docker 同源部署保持空数组；仅在 Console 与 API 分离部署时填写
TADAASK_ADMIN_CORS_ORIGINS=[]
# TADAASK_ADMIN_CORS_ORIGINS=["https://console.example.com"]

# 可选：后端首次下载模型时使用的运行期 HTTP 代理
# 基础镜像与依赖构建继续使用 Docker Desktop 自身代理设置；
# 运行中的容器访问宿主机代理时不能使用 localhost
# Docker Desktop 已启用内部代理时可使用 http.docker.internal:3128；
# 否则需让本地代理监听 Docker 可访问的网卡，再使用 host.docker.internal:10808
# TADAASK_HTTP_PROXY=http://http.docker.internal:3128
# TADAASK_HTTPS_PROXY=http://http.docker.internal:3128

# 可选：提高 Hugging Face 模型下载限额
# TADAASK_HF_TOKEN=
